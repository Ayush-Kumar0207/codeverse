NODE_ENV=development

# HTTP services
PORT=5000
DEPLOY_PORT=5001
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
DEPLOY_BRIDGE_BASE_URL=http://localhost:5001

# Distributed collaboration. Production should require a managed or replicated
# Redis deployment; local development can explicitly fall back to one process.
REDIS_URL=redis://localhost:6379
COLLABORATION_REQUIRE_REDIS=false
COLLABORATION_REDIS_PREFIX=codeverse:collaboration
COLLABORATION_ROOM_TTL_SECONDS=2592000
COLLABORATION_PRESENCE_TTL_SECONDS=90
COLLABORATION_RECOVERY_WINDOW_MS=120000

# Replace both values with independent random strings of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-session-secret
JWT_SECRET=replace-with-a-different-long-random-jwt-secret
EVIDENCE_SIGNING_KEY=replace-with-an-independent-proof-signing-key
EVIDENCE_SIGNING_ISSUER=codeverse-local-evaluator
EVIDENCE_SIGNING_KEY_ID=evidence-local-v1
ARENA_SIGNING_KEY=replace-with-an-independent-arena-report-key
ARENA_SIGNING_ISSUER=codeverse-local-arena
ARENA_SIGNING_KEY_ID=arena-local-v1

# Evidence execution and independent analyzer isolation.
# Development may use process workers. Production rejects process execution and
# requires Docker images pinned as name@sha256:<64 hex characters>.
EVIDENCE_REPLAY_ENGINE=process
EVIDENCE_ANALYZER_ENGINE=process
ARENA_EXECUTION_ENGINE=process
UNDERSTANDING_EXECUTION_ENGINE=process
EVIDENCE_NODE_RUNNER_IMAGE=node:22-alpine
EVIDENCE_PYTHON_RUNNER_IMAGE=python:3.13-alpine
EVIDENCE_JAVA_RUNNER_IMAGE=eclipse-temurin:21-jdk-alpine
EVIDENCE_GO_RUNNER_IMAGE=golang:1.25-alpine
EVIDENCE_C_RUNNER_IMAGE=gcc:15
EVIDENCE_CPP_RUNNER_IMAGE=gcc:15
EVIDENCE_RUST_RUNNER_IMAGE=rust:1.89-alpine
ARENA_RUNNER_IMAGE=node:22-alpine
UNDERSTANDING_RUNNER_IMAGE=node:22-alpine
EVIDENCE_ANALYZER_IMAGE=codeverse-server:local
EVIDENCE_BUILDER_AI=false
EVIDENCE_ALLOWED_IMAGES=node:22-alpine,python:3.13-alpine,eclipse-temurin:21-jdk-alpine,golang:1.25-alpine,gcc:15,rust:1.89-alpine,codeverse-server:local
# Production: use a dedicated rootless/TLS Docker endpoint; never mount the host socket.
DOCKER_HOST=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=

# Optional Supabase persistence
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Recommended for the server in production; never expose this key to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_MS=2500
SUPABASE_RETRY_COUNT=2

# Optional OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Code execution: local or remote
EXECUTION_STRATEGY=remote
ALLOW_LOCAL_EXECUTION=false
PISTON_URL=https://emkc.org/api/v2/piston/execute
PISTON_API_KEY=

# AI provider: ollama, openai, or auto
AI_PROVIDER=ollama
AI_MAX_CONTEXT_CHARS=16000
AI_MAX_PROMPT_CHARS=6000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EVIDENCE_REVIEW_AI=false

# Optional public deployment tunnel
DEPLOY_TUNNEL_ENABLED=false
DEPLOY_TUNNEL_SUBDOMAIN=
DEPLOY_TUNNEL_HOST=https://localtunnel.me
DEPLOY_TUNNEL_LOCAL_HOST=
